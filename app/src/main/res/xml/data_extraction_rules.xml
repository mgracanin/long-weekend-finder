<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up settings and saved plans, not downloaded holidays (they download again) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="holidays/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="holidays/" />
    </device-transfer>
</data-extraction-rules>
